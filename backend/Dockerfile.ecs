# ECS-optimized backend image: consumes a host-built Spring Boot jar while the
# runtime comes from a domestic registry mirror. Copying a host JRE is not
# portable across distributions because java.security may live outside
# JAVA_HOME (for example, an Ubuntu host JRE inside a Debian container).
ARG BASE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:21-jre
FROM ${BASE_IMAGE}

WORKDIR /app
ENV TZ=Asia/Shanghai

RUN sed -i 's@deb.debian.org@mirrors.cloud.aliyuncs.com@g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
    && apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY target/resumai-agent-backend.jar /app/resumai-agent-backend.jar
COPY src/main/resources/skills/ /app/skills/
COPY src/main/resources/mcp-servers.json /app/mcp-servers.json
COPY src/main/resources/mcp-servers.json /app/config/mcp-servers.json

EXPOSE 8080
# Force TLSv1.2: ECS→openrouter.ai TLS1.3 ClientHello hangs (DPI/path issue);
# openssl -tls1_2 succeeds. Domestic Qwen embeddings via OpenRouter need this.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=60", "-Djdk.tls.client.protocols=TLSv1.2", "-jar", "/app/resumai-agent-backend.jar"]
