{
  "patterns": [
    {
      "type": "时间线冲突",
      "description": "工作经历时间重叠、空窗期过长（>6个月）无合理解释、入职/离职时间不合逻辑",
      "severity": "high",
      "indicators": ["时间重叠", "长期空窗", "频繁跳槽（<1年）"]
    },
    {
      "type": "技能堆砌",
      "description": "列举大量技术但项目描述中无对应实践、技能组合不合逻辑（如同时精通矛盾技术栈）",
      "severity": "medium",
      "indicators": ["技能列表过长", "无项目佐证", "矛盾技术组合"]
    },
    {
      "type": "经验夸大",
      "description": "量化成果不合理（如'提升1000%'）、职级与年限不匹配、项目规模描述夸张",
      "severity": "high",
      "indicators": ["异常数据", "职级跳跃", "模糊量化"]
    },
    {
      "type": "信息矛盾",
      "description": "简历不同部分描述矛盾、与公开信息（GitHub/LinkedIn）不一致",
      "severity": "medium",
      "indicators": ["前后矛盾", "与公开资料不符", "学历信息模糊"]
    },
    {
      "type": "模板痕迹",
      "description": "简历内容高度相似于网络模板、个人特征描述过于通用、项目描述缺乏具体细节",
      "severity": "low",
      "indicators": ["模板化语言", "通用描述", "缺乏细节"]
    }
  ]
}
