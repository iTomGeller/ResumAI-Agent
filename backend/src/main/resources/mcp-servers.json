{
  "evidencePolicy": {
    "mode": "source-backed-only",
    "subjectBinding": "candidate-declared-identifiers-only",
    "emptyOrFailedResult": "unavailable",
    "requireSourceUrlForCandidateFacts": true,
    "allowSyntheticFallback": false
  },
  "mcpServers": {
    "exa": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
      "description": "Official Exa hosted MCP; real keyless web search and page fetch with rate limits",
      "allowedTools": ["web_search_exa", "web_fetch_exa"],
      "toolPrefix": "exa",
      "evidence": {
        "provider": "exa",
        "kind": "public-web",
        "subjectBinding": "candidate-declared-identifiers-only",
        "requiresSourceUrl": true
      }
    },
    "microsoft-learn": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://learn.microsoft.com/api/mcp",
      "description": "Official public Microsoft Learn MCP; current documentation search",
      "allowedTools": ["microsoft_docs_search"],
      "toolPrefix": "microsoft-learn",
      "evidence": {
        "provider": "microsoft-learn",
        "kind": "framework-docs",
        "subjectBinding": "not-candidate-evidence",
        "requiresSourceUrl": false
      }
    },
    "fetch": {
      "enabled": true,
      "default": true,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_server_fetch"],
      "description": "Official MCP reference fetch server; candidate-declared public URLs only",
      "allowedTools": ["fetch"],
      "toolPrefix": "fetch",
      "whitelistOnly": true,
      "evidence": {
        "provider": "fetch",
        "kind": "public-web",
        "subjectBinding": "candidate-declared-url",
        "requiresSourceUrl": true
      }
    }
  },
  "optionalMcpServers": {},
  "agentToolRouting": {
    "JDAnalysisAgent": [
      "microsoft-learn.microsoft_docs_search"
    ],
    "TechAgent": [
      "microsoft-learn.microsoft_docs_search"
    ],
    "ProjectAgent": [
      "exa.web_search_exa",
      "exa.web_fetch_exa",
      "fetch.fetch"
    ],
    "EvidenceAgent": [
      "exa.web_search_exa",
      "exa.web_fetch_exa",
      "fetch.fetch"
    ],
    "RiskAgent": [],
    "ReportAgent": [],
    "InterviewQuestionAgent": [
      "microsoft-learn.microsoft_docs_search"
    ]
  }
}
