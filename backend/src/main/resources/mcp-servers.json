{
  "evidencePolicy": {
    "mode": "source-backed-only",
    "subjectBinding": "candidate-declared-identifiers-only",
    "emptyOrFailedResult": "unavailable",
    "requireSourceUrlForCandidateFacts": true,
    "allowSyntheticFallback": false
  },
  "mcpServers": {
    "exa": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
      "description": "Official Exa hosted MCP; real keyless web search and page fetch with rate limits",
      "routingGuidance": "Fallback only after direct fetch reports network unreachability, or when the user explicitly asks to discover alternative public sources. Do not use Exa after an exact declared URL returns 404. Stop immediately on free-tier rate limiting.",
      "timeoutSeconds": 20,
      "maxConcurrentCalls": 1,
      "minIntervalMs": 900,
      "rateLimitRetries": 0,
      "rateLimitBackoffMs": 1200,
      "rateLimitCooldownSeconds": 180,
      "allowedTools": ["web_search_exa", "web_fetch_exa"],
      "toolPrefix": "exa",
      "evidence": {
        "provider": "exa",
        "kind": "public-web",
        "subjectBinding": "candidate-declared-identifiers-only",
        "requiresSourceUrl": true
      }
    },
    "fetch": {
      "enabled": true,
      "default": true,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_server_fetch"],
      "description": "Official MCP reference fetch server; candidate-declared public URLs only",
      "routingGuidance": "First choice for every candidate-declared exact URL, including github.com, because the CN ECS runtime probe is currently reachable. A 404 means the exact declared page is unavailable; do not follow it with a same-name web search.",
      "timeoutSeconds": 8,
      "allowedTools": ["fetch"],
      "toolPrefix": "fetch",
      "whitelistOnly": true,
      "evidence": {
        "provider": "fetch",
        "kind": "public-web",
        "subjectBinding": "candidate-declared-url",
        "requiresSourceUrl": true
      }
    }
  },
  "optionalMcpServers": {},
  "agentToolRouting": {
    "TechAgent": [],
    "ProjectAgent": [
      "fetch.fetch",
      "exa.web_fetch_exa",
      "exa.web_search_exa"
    ],
    "EvidenceAgent": [
      "exa.web_search_exa",
      "exa.web_fetch_exa",
      "fetch.fetch"
    ],
    "RiskAgent": [],
    "ReportAgent": []
  }
}
