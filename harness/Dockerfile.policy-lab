FROM python:3.12-slim

WORKDIR /opt/resumai

RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
    "urllib3>=2.0" requests

# Harness + minimal workflow imports used by evolve_policies / e2e helpers.
COPY harness ./harness
COPY workflow/app ./workflow/app
COPY testdata ./testdata

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/opt/resumai/harness:/opt/resumai/workflow

# No production MySQL / MinIO credentials — talks to Java Policy Lab APIs only.
CMD ["python", "harness/evolve_policies.py", "--worker", "--base", "http://ai-resume-backend:8080"]
