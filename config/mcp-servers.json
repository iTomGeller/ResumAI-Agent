{
  "evidencePolicy": {
    "mode": "source-backed-only",
    "subjectBinding": "candidate-declared-identifiers-only",
    "emptyOrFailedResult": "unavailable",
    "requireSourceUrlForCandidateFacts": true,
    "allowSyntheticFallback": false
  },
  "mcpServers": {
    "bing_cn": {
      "enabled": true,
      "default": true,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "app.runtime.bing_cn_mcp_server"],
      "description": "Keyless standard MCP search server using Bing's mainland China RSS endpoint",
      "routingGuidance": "Discovery fallback only for candidate-declared identifiers. Search hits are leads, never verified candidate facts; fetch the selected exact URL before citing it. Do not search after an exact declared URL returns 404.",
      "timeoutSeconds": 15,
      "maxConcurrentCalls": 2,
      "minIntervalMs": 300,
      "rateLimitRetries": 1,
      "rateLimitBackoffMs": 500,
      "rateLimitCooldownSeconds": 60,
      "allowedTools": ["web_search"],
      "toolPrefix": "bing_cn",
      "evidence": {
        "provider": "bing-cn-rss",
        "kind": "public-web",
        "subjectBinding": "candidate-declared-identifiers-only",
        "requiresSourceUrl": true
      }
    },
    "fetch": {
      "enabled": true,
      "default": true,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_server_fetch"],
      "description": "Official MCP reference fetch server; candidate-declared public URLs only",
      "routingGuidance": "First choice for every candidate-declared exact URL, including github.com, because the CN ECS runtime probe is currently reachable. A 404 means the exact declared page is unavailable; do not follow it with a same-name web search.",
      "timeoutSeconds": 8,
      "allowedTools": ["fetch"],
      "toolPrefix": "fetch",
      "whitelistOnly": true,
      "evidence": {
        "provider": "fetch",
        "kind": "public-web",
        "subjectBinding": "candidate-declared-url",
        "requiresSourceUrl": true
      }
    }
  },
  "optionalMcpServers": {},
  "agentToolRouting": {
    "TechAgent": [],
    "ProjectAgent": [
      "fetch.fetch",
      "bing_cn.web_search"
    ],
    "EvidenceAgent": [
      "bing_cn.web_search",
      "fetch.fetch"
    ],
    "RiskAgent": [],
    "ReportAgent": []
  }
}
