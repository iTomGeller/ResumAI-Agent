{
  "evidencePolicy": {
    "mode": "source-backed-only",
    "subjectBinding": "candidate-declared-identifiers-only",
    "emptyOrFailedResult": "unavailable",
    "requireSourceUrlForCandidateFacts": true,
    "allowSyntheticFallback": false
  },
  "mcpServers": {
    "exa": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
      "description": "Official Exa hosted MCP; keyless free tier",
      "allowedTools": ["web_search_exa", "web_fetch_exa"],
      "toolPrefix": "exa",
      "evidence": {
        "provider": "exa",
        "kind": "public-web",
        "subjectBinding": "unverified",
        "requiresSourceUrl": true
      }
    },
    "firecrawl": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "description": "Official Firecrawl hosted MCP; keyless search/scrape are rate limited",
      "allowedTools": ["firecrawl_search", "firecrawl_scrape", "firecrawl_map"],
      "toolPrefix": "firecrawl",
      "evidence": {
        "provider": "firecrawl",
        "kind": "public-web",
        "subjectBinding": "unverified",
        "requiresSourceUrl": true
      }
    },
    "context7": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://mcp.context7.com/mcp",
      "description": "Official Context7 docs MCP for library version/capability lookup",
      "allowedTools": ["resolve-library-id", "query-docs"],
      "toolPrefix": "context7",
      "evidence": {
        "provider": "context7",
        "kind": "framework-docs",
        "subjectBinding": "not_candidate_evidence",
        "requiresSourceUrl": false
      }
    },
    "fetch": {
      "enabled": true,
      "default": true,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_server_fetch"],
      "description": "MCP reference fetch stdio fallback; allowlisted candidate-declared URLs only",
      "allowedTools": ["fetch"],
      "toolPrefix": "fetch",
      "whitelistOnly": true,
      "evidence": {
        "provider": "fetch",
        "kind": "public-web",
        "subjectBinding": "candidate-declared-url",
        "requiresSourceUrl": true
      }
    }
  },
  "optionalMcpServers": {
    "github": {
      "enabled": false,
      "default": false,
      "requiredEnv": ["GITHUB_TOKEN"],
      "transport": "streamable-http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}",
        "X-MCP-Toolsets": "repos,users",
        "X-MCP-Readonly": "true"
      },
      "description": "GitHub official remote MCP; AUTH_REQUIRED without GITHUB_TOKEN — never pretend enabled",
      "healthStatusWhenMissingEnv": "AUTH_REQUIRED"
    },
    "tavily": {
      "enabled": false,
      "default": false,
      "transport": "streamable-http",
      "url": "https://mcp.tavily.com/mcp",
      "optionalEnv": ["TAVILY_API_KEY"],
      "headers": {
        "Authorization": "Bearer ${TAVILY_API_KEY}"
      },
      "description": "Official Tavily search/extract MCP; optional alternative provider"
    },
    "brave-search": {
      "enabled": false,
      "default": false,
      "requiredEnv": ["BRAVE_API_KEY"],
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server", "--transport", "stdio"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Official Brave Search MCP; requires Node.js 22+ and BRAVE_API_KEY"
    },
    "time": {
      "enabled": false,
      "default": false,
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-time"],
      "description": "Official MCP reference time server"
    },
    "arxiv": {
      "enabled": false,
      "default": false,
      "transport": "stdio",
      "command": "uvx",
      "args": ["arxiv-mcp-server"],
      "description": "Maintainer-published arXiv MCP for technical-paper evidence"
    }
  },
  "agentToolRouting": {
    "JDAnalysisAgent": ["firecrawl.firecrawl_scrape", "firecrawl.firecrawl_search", "firecrawl.firecrawl_map", "context7.resolve-library-id", "context7.query-docs"],
    "TechAgent": ["context7.resolve-library-id", "context7.query-docs", "exa.web_search_exa"],
    "ProjectAgent": ["exa.web_search_exa", "exa.web_fetch_exa", "firecrawl.firecrawl_scrape", "firecrawl.firecrawl_search", "firecrawl.firecrawl_map", "mcp_fetch_url", "fetch.fetch"],
    "EvidenceAgent": ["exa.web_search_exa", "exa.web_fetch_exa", "mcp_fetch_url", "fetch.fetch", "firecrawl.firecrawl_scrape"],
    "RiskAgent": ["exa.web_search_exa", "mcp_fetch_url", "fetch.fetch"],
    "ReportAgent": [],
    "InterviewQuestionAgent": ["context7.resolve-library-id", "context7.query-docs"]
  }
}
