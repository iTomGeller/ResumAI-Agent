{
  "evidencePolicy": {
    "mode": "source-backed-only",
    "subjectBinding": "candidate-declared-identifiers-only",
    "emptyOrFailedResult": "unavailable",
    "requireSourceUrlForCandidateFacts": true,
    "allowSyntheticFallback": false
  },
  "mcpServers": {
    "exa": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
      "description": "Official Exa hosted MCP; real keyless web search and page fetch with rate limits",
      "allowedTools": ["web_search_exa", "web_fetch_exa"],
      "toolPrefix": "exa",
      "evidence": {
        "provider": "exa",
        "kind": "public-web",
        "subjectBinding": "candidate-declared-identifiers-only",
        "requiresSourceUrl": true
      }
    },
    "context7": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://mcp.context7.com/mcp",
      "description": "Official Context7 remote MCP for current framework and library documentation",
      "allowedTools": ["resolve-library-id", "query-docs"],
      "toolPrefix": "context7",
      "evidence": {
        "provider": "context7",
        "kind": "framework-docs",
        "subjectBinding": "not-candidate-evidence",
        "requiresSourceUrl": false
      }
    },
    "deepwiki": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://mcp.deepwiki.com/mcp",
      "description": "Official Cognition DeepWiki public MCP for documentation of candidate-declared public repositories",
      "allowedTools": ["read_wiki_structure", "read_wiki_contents", "ask_question"],
      "toolPrefix": "deepwiki",
      "evidence": {
        "provider": "deepwiki",
        "kind": "repository-docs",
        "subjectBinding": "candidate-declared-repository-only",
        "requiresSourceUrl": true
      }
    },
    "microsoft-learn": {
      "enabled": true,
      "default": true,
      "transport": "streamable-http",
      "url": "https://learn.microsoft.com/api/mcp",
      "description": "Official public Microsoft Learn MCP; unauthenticated current documentation and code samples",
      "allowedTools": ["microsoft_docs_search", "microsoft_docs_fetch", "microsoft_code_sample_search"],
      "toolPrefix": "microsoft-learn",
      "evidence": {
        "provider": "microsoft-learn",
        "kind": "framework-docs",
        "subjectBinding": "not-candidate-evidence",
        "requiresSourceUrl": false
      }
    },
    "fetch": {
      "enabled": true,
      "default": true,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_server_fetch"],
      "description": "Official MCP reference fetch server; candidate-declared public URLs only",
      "allowedTools": ["fetch"],
      "toolPrefix": "fetch",
      "whitelistOnly": true,
      "evidence": {
        "provider": "fetch",
        "kind": "public-web",
        "subjectBinding": "candidate-declared-url",
        "requiresSourceUrl": true
      }
    }
  },
  "optionalMcpServers": {},
  "agentToolRouting": {
    "JDAnalysisAgent": [
      "context7.resolve-library-id",
      "context7.query-docs",
      "microsoft-learn.microsoft_docs_search",
      "microsoft-learn.microsoft_docs_fetch",
      "exa.web_search_exa"
    ],
    "TechAgent": [
      "context7.resolve-library-id",
      "context7.query-docs",
      "microsoft-learn.microsoft_docs_search",
      "microsoft-learn.microsoft_code_sample_search",
      "exa.web_search_exa"
    ],
    "ProjectAgent": [
      "exa.web_search_exa",
      "exa.web_fetch_exa",
      "deepwiki.read_wiki_structure",
      "deepwiki.read_wiki_contents",
      "deepwiki.ask_question",
      "fetch.fetch"
    ],
    "EvidenceAgent": [
      "exa.web_search_exa",
      "exa.web_fetch_exa",
      "deepwiki.read_wiki_structure",
      "deepwiki.read_wiki_contents",
      "deepwiki.ask_question",
      "fetch.fetch"
    ],
    "RiskAgent": [
      "exa.web_search_exa",
      "fetch.fetch"
    ],
    "ReportAgent": [],
    "InterviewQuestionAgent": [
      "context7.resolve-library-id",
      "context7.query-docs",
      "microsoft-learn.microsoft_docs_search",
      "microsoft-learn.microsoft_code_sample_search"
    ]
  }
}
