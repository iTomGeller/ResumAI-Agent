MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=resumai_agent
MYSQL_USER=resumai
MYSQL_PASSWORD=change-me-mysql-password

REDIS_PASSWORD=change-me-redis-password
NEO4J_AUTH=neo4j/change-me-neo4j-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

BACKEND_PORT=8080
FRONTEND_PORT=80
UPLOAD_DIR=/opt/ai-resume-agent-platform/uploads

SPRING_PROFILES_ACTIVE=local
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_QUALITY_MODEL=deepseek-v4-pro

# Alibaba Cloud DashScope (Bailian) embedding — used for Milvus semantic recall.
# Get your key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# Internal control-plane token shared by backend and agent runtime.
WORKFLOW_INTERNAL_TOKEN=replace-with-a-long-random-token
