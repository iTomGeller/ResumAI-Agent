MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=resumai_agent
MYSQL_USER=resumai
MYSQL_PASSWORD=change-me-mysql-password

REDIS_PASSWORD=change-me-redis-password
NEO4J_AUTH=neo4j/change-me-neo4j-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

BACKEND_PORT=8080
FRONTEND_PORT=80
UPLOAD_DIR=/opt/ai-resume-agent-platform/uploads

SPRING_PROFILES_ACTIVE=local
LANGSMITH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Internal control-plane token shared by backend / agent runtime / sandbox
# manager (required in production)
WORKFLOW_INTERNAL_TOKEN=replace-with-a-long-random-token

# Sandbox worker image tag. The deploy script pins this to the git sha of the
# deployed commit — never use latest. Compose refuses to start without it.
SANDBOX_WORKER_TAG=set-by-deploy-script
SANDBOX_ENABLED=true
SANDBOX_MAX_CONCURRENT=2
SANDBOX_MEM_LIMIT=384m
SANDBOX_CPU=0.5
SANDBOX_TTL_SECONDS=240

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional external Langfuse deployment; leave blank when not provisioned.
LANGFUSE_HOST=
# Docker network example: http://langfuse-web:3000/api/public/otel
# OTEL_EXPORTER_OTLP_ENDPOINT is an alias; both backend and workflow read either.
LANGFUSE_OTEL_ENDPOINT=
LANGFUSE_PUBLIC_URL=

GRAFANA_PASSWORD=change-me-grafana-password
PUBLIC_HOST=localhost
