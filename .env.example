MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=resumai_agent
MYSQL_USER=resumai
MYSQL_PASSWORD=change-me-mysql-password

REDIS_PASSWORD=change-me-redis-password
NEO4J_AUTH=neo4j/change-me-neo4j-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

BACKEND_PORT=8080
FRONTEND_PORT=80
UPLOAD_DIR=/opt/ai-resume-agent-platform/uploads

SPRING_PROFILES_ACTIVE=local
LANGSMITH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# LangGraph runtime / checkpoint persistence (required in production)
WORKFLOW_INTERNAL_TOKEN=replace-with-a-long-random-token
WORKFLOW_POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Public MCP providers. Exa/Firecrawl have limited keyless hosted modes; the
# others remain disabled until their corresponding credential is provided.
EXA_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
TAVILY_API_KEY=
BRAVE_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional external Langfuse deployment; leave blank when not provisioned.
LANGFUSE_HOST=
LANGFUSE_OTEL_ENDPOINT=
LANGFUSE_PUBLIC_URL=

GRAFANA_PASSWORD=change-me-grafana-password
PUBLIC_HOST=localhost
