{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "运行总览 (LabelHub 结构)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "评估运行总数",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(resumai_funnel_evaluation_started_total{job_category=~\"$job_category\"})", "legendFormat": "Runs" }]
    },
    {
      "title": "RAG 召回次数",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "sum(resumai_rag_search_result_count_count)", "legendFormat": "Retrievals" }]
    },
    {
      "title": "RAG 空召回率",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "sum(resumai_rag_retrieval_empty_results_total) / clamp_min(sum(resumai_rag_search_result_count_count), 1)", "legendFormat": "Empty Rate" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "title": "Skill 调用",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "sum(resumai_skill_invocation_total{agent=~\"$agent\"})", "legendFormat": "Skills" }]
    },
    {
      "title": "MCP 调用 / Context",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "sum(resumai_mcp_call_count_total) or sum(resumai_dag_node_duration_seconds_count{step_kind=\"mcp_call\"})", "legendFormat": "MCP" }]
    },
    {
      "title": "Pipeline P95 耗时",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(resumai_dag_node_duration_seconds_bucket{step_kind=~\"$step_kind\",lane_id=~\"$lane_id\"}[5m])))", "legendFormat": "P95" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "📈 Business Funnel",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "title": "Resume Uploads",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum by (file_type) (resumai_funnel_upload_count_total)", "legendFormat": "{{file_type}}" }]
    },
    {
      "title": "Evaluations Started",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "sum(resumai_funnel_evaluation_started_total)", "legendFormat": "Started" }]
    },
    {
      "title": "Evaluations Completed",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "sum(resumai_funnel_evaluation_completed_total)", "legendFormat": "Completed" }]
    },
    {
      "title": "Funnel Conversion Rate",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "resumai_funnel_conversion_rate", "legendFormat": "Conversion" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.6}, {"color": "green", "value": 0.85}] } } }
    },
    {
      "title": "Time to Screen (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (job_category, le) (rate(resumai_funnel_time_to_screen_seconds_bucket[5m])))", "legendFormat": "{{job_category}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Recommendation Distribution",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "sum by (recommendation) (resumai_funnel_recommendation_count_total)", "legendFormat": "{{recommendation}}" }]
    },
    {
      "title": "🤖 Agent Execution",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false
    },
    {
      "title": "Agent Span Duration (avg)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "rate(resumai_agent_span_duration_seconds_sum[5m]) / rate(resumai_agent_span_duration_seconds_count[5m])", "legendFormat": "{{agent}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Concurrent Active Agents",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 4, "x": 6, "y": 8 },
      "targets": [{ "expr": "resumai_agent_concurrent_active", "legendFormat": "Active" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 10, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 4}, {"color": "red", "value": 6}] } } }
    },
    {
      "title": "Agent Delegations",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 5, "x": 10, "y": 8 },
      "targets": [{ "expr": "sum by (from_agent, to_agent) (resumai_agent_delegation_total)", "legendFormat": "{{from_agent}}→{{to_agent}}" }]
    },
    {
      "title": "Agent Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 4, "x": 15, "y": 8 },
      "targets": [{ "expr": "sum(resumai_agent_error_total)", "legendFormat": "Errors" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}] } } }
    },
    {
      "title": "Routing Decisions",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 5, "x": 19, "y": 8 },
      "targets": [{ "expr": "sum by (decision) (resumai_agent_routing_decision_total)", "legendFormat": "{{decision}}" }]
    },
    {
      "title": "🔧 Tool Calls",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "title": "Tool Call Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 16 },
      "targets": [{ "expr": "rate(resumai_tool_call_duration_seconds_sum[5m]) / rate(resumai_tool_call_duration_seconds_count[5m])", "legendFormat": "{{tool_name}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Tool Call Count",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 4, "x": 6, "y": 16 },
      "targets": [{ "expr": "sum by (tool_name, status) (resumai_tool_call_count_total)", "legendFormat": "{{tool_name}} ({{status}})" }]
    },
    {
      "title": "Tool Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 3, "x": 10, "y": 16 },
      "targets": [{ "expr": "sum(resumai_tool_call_error_total)", "legendFormat": "Errors" }]
    },
    {
      "title": "Milvus Chunks Indexed",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 3, "x": 13, "y": 16 },
      "targets": [{ "expr": "resumai_tool_milvus_chunks_indexed_sum / resumai_tool_milvus_chunks_indexed_count", "legendFormat": "Avg Chunks" }]
    },
    {
      "title": "Milvus Similarity Scores",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 4, "x": 16, "y": 16 },
      "targets": [{ "expr": "rate(resumai_tool_milvus_similarity_score_sum[5m]) / rate(resumai_tool_milvus_similarity_score_count[5m])", "legendFormat": "Avg Score" }]
    },
    {
      "title": "Neo4j Nodes Written",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 4, "x": 20, "y": 16 },
      "targets": [{ "expr": "rate(resumai_tool_neo4j_nodes_written_sum[5m]) / rate(resumai_tool_neo4j_nodes_written_count[5m])", "legendFormat": "{{operation}}" }]
    },
    {
      "title": "🧠 LLM Economics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "title": "LLM Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 24 },
      "targets": [{ "expr": "rate(resumai_llm_duration_seconds_sum[5m]) / rate(resumai_llm_duration_seconds_count[5m])", "legendFormat": "{{model}}/{{purpose}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Input Tokens (avg)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 3, "x": 6, "y": 24 },
      "targets": [{ "expr": "resumai_llm_tokens_input_sum / resumai_llm_tokens_input_count", "legendFormat": "Input" }]
    },
    {
      "title": "Output Tokens (avg)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 3, "x": 9, "y": 24 },
      "targets": [{ "expr": "resumai_llm_tokens_output_sum / resumai_llm_tokens_output_count", "legendFormat": "Output" }]
    },
    {
      "title": "Total LLM Tokens",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 3, "x": 12, "y": 24 },
      "targets": [{ "expr": "sum(resumai_llm_tokens_total_total)", "legendFormat": "Total" }]
    },
    {
      "title": "Cost per Call (avg USD)",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 3, "x": 15, "y": 24 },
      "targets": [{ "expr": "resumai_llm_cost_per_call_sum / resumai_llm_cost_per_call_count", "legendFormat": "USD/call" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 6 } }
    },
    {
      "title": "LLM Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 3, "x": 18, "y": 24 },
      "targets": [{ "expr": "sum(resumai_llm_error_total)", "legendFormat": "Errors" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}] } } }
    },
    {
      "title": "Token Efficiency",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 3, "x": 21, "y": 24 },
      "targets": [{ "expr": "resumai_llm_token_efficiency", "legendFormat": "out/in" }]
    },
    {
      "title": "🔍 RAG Quality",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },
    {
      "title": "Faithfulness",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 32 },
      "targets": [{ "expr": "resumai_rag_faithfulness_sum / resumai_rag_faithfulness_count", "legendFormat": "Faithfulness" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "green", "value": 0.85}] } } }
    },
    {
      "title": "Answer Relevancy",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 32 },
      "targets": [{ "expr": "resumai_rag_answer_relevancy_sum / resumai_rag_answer_relevancy_count", "legendFormat": "Relevancy" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "green", "value": 0.85}] } } }
    },
    {
      "title": "Context Precision",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 32 },
      "targets": [{ "expr": "resumai_rag_context_precision_sum / resumai_rag_context_precision_count", "legendFormat": "Precision" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } }
    },
    {
      "title": "Overall RAG Quality",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 12, "y": 32 },
      "targets": [{ "expr": "rate(resumai_rag_overall_quality_sum[5m]) / rate(resumai_rag_overall_quality_count[5m])", "legendFormat": "Overall" }]
    },
    {
      "title": "Retrieval Failures",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 32 },
      "targets": [
        { "expr": "sum(resumai_rag_retrieval_empty_results_total)", "legendFormat": "Empty", "refId": "A" },
        { "expr": "sum(resumai_rag_retrieval_below_threshold_total)", "legendFormat": "Below Threshold", "refId": "B" }
      ]
    },
    {
      "title": "💬 HR Feedback + System Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "collapsed": false
    },
    {
      "title": "HR Feedback Submitted",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 39 },
      "targets": [{ "expr": "sum(resumai_funnel_feedback_submitted_total)", "legendFormat": "Feedback" }]
    },
    {
      "title": "HR-AI Agreement",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 39 },
      "targets": [{ "expr": "sum by (agrees_with_ai) (resumai_funnel_feedback_agreement_total)", "legendFormat": "agrees={{agrees_with_ai}}" }]
    },
    {
      "title": "Executor Active Threads",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 39 },
      "targets": [{ "expr": "resumai_system_executor_active_threads", "legendFormat": "Threads" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 6 } }
    },
    {
      "title": "Executor Queue Size",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 39 },
      "targets": [{ "expr": "resumai_system_executor_queue_size", "legendFormat": "Queue" }]
    },
    {
      "title": "SSE Active Subscribers",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 39 },
      "targets": [{ "expr": "resumai_system_sse_active_subscribers", "legendFormat": "SSE" }]
    },
    {
      "title": "Task Cache Size",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 39 },
      "targets": [{ "expr": "resumai_system_memory_task_cache_size", "legendFormat": "Tasks" }]
    },
    {
      "title": "🎯 HR Business Metrics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "collapsed": false
    },
    {
      "title": "JD Auto-Match Success Rate",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 47 },
      "targets": [{ "expr": "sum(resumai_jd_auto_match_total{matched=\"true\"}) / sum(resumai_jd_auto_match_total) * 100", "legendFormat": "Match Rate %" }],
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" } }
    },
    {
      "title": "JD Match Score Distribution",
      "type": "histogram",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 47 },
      "targets": [{ "expr": "resumai_jd_match_score_sum / clamp_min(resumai_jd_match_score_count, 1)", "legendFormat": "Avg Score" }]
    },
    {
      "title": "HR Feedback Consistency",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 47 },
      "targets": [
        { "expr": "sum(resumai_hr_feedback_consistency_total{agree=\"true\"})", "legendFormat": "Agree" },
        { "expr": "sum(resumai_hr_feedback_consistency_total{agree=\"false\"})", "legendFormat": "Disagree" }
      ]
    },
    {
      "title": "Screening Funnel",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 47 },
      "targets": [
        { "expr": "sum(resumai_funnel_upload_count_total)", "legendFormat": "Uploaded" },
        { "expr": "sum(resumai_funnel_evaluation_completed_total{status=\"SUCCESS\"})", "legendFormat": "Evaluated" },
        { "expr": "sum(resumai_funnel_recommendation_total{recommendation=\"STRONG_RECOMMEND\"})+sum(resumai_funnel_recommendation_total{recommendation=\"RECOMMEND\"})", "legendFormat": "Recommended" }
      ]
    },
    {
      "title": "Avg Time to Screen",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 53 },
      "targets": [{ "expr": "histogram_quantile(0.5, rate(resumai_funnel_time_to_screen_seconds_bucket[5m]))", "legendFormat": "P50" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "🔧 Developer Agent/MCP/RAG Panel",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 60 },
      "collapsed": false
    },
    {
      "title": "DAG Node Duration by Step",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 61 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(resumai_dag_node_duration_seconds_bucket[5m]))", "legendFormat": "{{step_kind}} / {{lane_id}}" }]
    },
    {
      "title": "Parallel Group Bottleneck",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 61 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(resumai_dag_parallel_bottleneck_seconds_bucket[5m]))", "legendFormat": "{{dag_group}} / {{bottleneck_lane}}" }]
    },
    {
      "title": "Skill Invocations",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 61 },
      "targets": [{ "expr": "sum by (skill_name, success) (resumai_skill_invocation_total)", "legendFormat": "{{skill_name}} ({{success}})" }]
    },
    {
      "title": "MCP Call Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 68 },
