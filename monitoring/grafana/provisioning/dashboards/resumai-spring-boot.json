  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "📊 运营总览",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "评估启动次数",
      "description": "累计启动的简历评估任务数。无样本时显示 0，不代表故障。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(resumai_funnel_evaluation_started_total{job_category=~\"$job_category\"}) or vector(0)",
          "legendFormat": "启动"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "评估完成次数",
      "description": "已成功结束（含成功/失败）的评估任务。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(resumai_funnel_evaluation_completed_total) or vector(0)",
          "legendFormat": "完成"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "漏斗转化率",
      "description": "上传 → 完成评估的转化比例。样本不足时可能为 0。",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "resumai_funnel_conversion_rate or vector(0)",
          "legendFormat": "转化率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "筛选 P95 耗时",
      "description": "从任务创建到报告就绪的 P95 耗时，反映 HR 等待体验。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(resumai_funnel_time_to_screen_seconds_bucket[$__rate_interval]))) or vector(0)",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "暂无样本"
        }
      }
    },
    {
