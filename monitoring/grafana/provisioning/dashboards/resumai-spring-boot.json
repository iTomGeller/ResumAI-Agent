    {
      "title": "SSE 实时订阅",
      "description": "前端 Trace 推送的活跃连接数。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "resumai_system_sse_active_subscribers or vector(0)",
          "legendFormat": "订阅"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本"
        }
      }
    },
    {
      "type": "row",
      "title": "📈 招聘漏斗",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "collapsed": false
    },
    {
      "title": "简历上传（按格式）",
      "description": "各格式简历上传量。PDF/TXT 等。",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum by (file_type) (resumai_funnel_upload_count_total)",
          "legendFormat": "{{file_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "评估启动趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(rate(resumai_funnel_evaluation_started_total{job_category=~\"$job_category\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "启动/秒"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "推荐结论分布",
      "description": "按推荐结论统计：强烈推荐、推荐、需人工复核、拒绝。",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "label_replace(label_replace(label_replace(label_replace(sum by (recommendation) (resumai_funnel_recommendation_count_total), \"recommendation\", \"需人工复核\", \"recommendation\", \"NEED_MANUAL_REVIEW\"), \"recommendation\", \"推荐\", \"recommendation\", \"RECOMMEND\"), \"recommendation\", \"强烈推荐\", \"recommendation\", \"STRONG_RECOMMEND\"), \"recommendation\", \"拒绝\", \"recommendation\", \"REJECT\")",
          "legendFormat": "{{recommendation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本",
          "mappings": [
            {
              "type": "value",
              "options": {
                "NEED_MANUAL_REVIEW": {
                  "index": 0,
                  "text": "需人工复核"
                },
                "RECOMMEND": {
                  "index": 1,
                  "text": "推荐"
                },
                "STRONG_RECOMMEND": {
                  "index": 2,
                  "text": "强烈推荐"
                },
                "REJECT": {
                  "index": 3,
                  "text": "拒绝"
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "JD 自动匹配成功率",
      "description": "RAG 智能岗位匹配的命中率。",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(resumai_jd_auto_match_total{matched=\"true\"}) / clamp_min(sum(resumai_jd_auto_match_total), 1) or vector(0)",
          "legendFormat": "匹配率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "暂无样本"
        }
      }
    },
