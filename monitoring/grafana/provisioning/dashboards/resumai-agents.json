{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Agent 执行视图",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "任务编排 P95 延迟",
      "description": "任务创建节点耗时 P95",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(histogram_quantile(0.95, sum by (le) (rate(resumai_dag_node_duration_seconds_bucket{step_kind=\"task_create\"}[$__rate_interval]))), \"step_kind\", \"创建任务\", \"step_kind\", \"task_create\"), \"step_kind\", \"上传解析\", \"step_kind\", \"upload_parse\"), \"step_kind\", \"简历解析\", \"step_kind\", \"resume_parse\"), \"step_kind\", \"岗位匹配\", \"step_kind\", \"jd_match\"), \"step_kind\", \"能力评估\", \"step_kind\", \"skill_eval\"), \"step_kind\", \"证据融合\", \"step_kind\", \"rag_retrieve\"), \"step_kind\", \"AI 评估\", \"step_kind\", \"llm_complete\"), \"step_kind\", \"质量校验\", \"step_kind\", \"quality_check\"), \"step_kind\", \"报告生成\", \"step_kind\", \"report_generate\"), \"step_kind\", \"外部检索\", \"step_kind\", \"mcp_call\"), \"step_kind\", \"工具调用\", \"step_kind\", \"tool_call\"), \"step_kind\", \"索引校验\", \"step_kind\", \"rag_index_verify\") or vector(0)",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "暂无样本",
          "mappings": [
            {
              "type": "value",
              "options": {
                "task_create": {
                  "index": 0,
                  "text": "创建任务"
                },
                "upload_parse": {
                  "index": 1,
                  "text": "上传解析"
                },
                "resume_parse": {
                  "index": 2,
                  "text": "简历解析"
                },
                "jd_match": {
                  "index": 3,
                  "text": "岗位匹配"
                },
                "skill_eval": {
                  "index": 4,
                  "text": "能力评估"
                },
                "rag_retrieve": {
                  "index": 5,
                  "text": "证据融合"
                },
                "llm_complete": {
                  "index": 6,
                  "text": "AI 评估"
                },
                "quality_check": {
                  "index": 7,
                  "text": "质量校验"
                },
                "report_generate": {
                  "index": 8,
                  "text": "报告生成"
                },
                "mcp_call": {
                  "index": 9,
                  "text": "外部检索"
                },
                "tool_call": {
                  "index": 10,
                  "text": "工具调用"
                },
                "rag_index_verify": {
                  "index": 11,
                  "text": "索引校验"
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "简历解析成功率",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(resumai_funnel_parse_success_total) / clamp_min(sum(resumai_funnel_parse_success_total) + sum(resumai_funnel_parse_failure_total), 1) or vector(0)",
          "legendFormat": "成功"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "最佳岗位匹配分",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(resumai_jd_match_score_sum) / clamp_min(sum(resumai_jd_match_score_count), 1) or vector(0)",
          "legendFormat": "Top1 分数"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "能力模块调用分布",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(sum by (skill_name) (resumai_skill_invocation_total{agent=~\"$agent\"}), \"agent\", \"任务编排器\", \"agent\", \"OrchestratorAgent\"), \"agent\", \"简历解析器\", \"agent\", \"ResumeParserAgent\"), \"agent\", \"技术评估\", \"agent\", \"TechAgent\"), \"agent\", \"项目评估\", \"agent\", \"ProjectAgent\"), \"agent\", \"风险识别\", \"agent\", \"RiskAgent\"), \"agent\", \"岗位匹配\", \"agent\", \"JdMatchAgent\"), \"agent\", \"质量校验\", \"agent\", \"RagasJudgeAgent\"), \"agent\", \"报告生成\", \"agent\", \"FinalReportAgent\"), \"agent\", \"大模型评估\", \"agent\", \"DeepSeekChatModel\"), \"agent\", \"混合检索\", \"agent\", \"HybridRagStrategy\"), \"agent\", \"需求分析\", \"agent\", \"JdAnalysisAgent\"), \"agent\", \"历史匹配\", \"agent\", \"HistoricalRagAgent\"), \"agent\", \"外部检索\", \"agent\", \"ExternalProfileAgent\"), \"agent\", \"并发引擎\", \"agent\", \"DAGEngine\")",
          "legendFormat": "{{skill_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "RAG 空召回",
      "description": "空召回升高不等于系统故障，可能为配置降级或无相关证据",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(resumai_rag_retrieval_empty_results_total) or vector(0)",
          "legendFormat": "空召回"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "大模型响应耗时 P95 / Token 消耗",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(resumai_llm_duration_seconds_bucket[$__rate_interval]))) or vector(0)",
          "legendFormat": "P95 延迟"
        },
        {
          "expr": "sum(rate(resumai_llm_tokens_total[$__rate_interval])) or vector(0)",
          "legendFormat": "Token/秒"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "暂无样本"
        }
      }
    },
    {
      "title": "最终推荐分布",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "label_replace(label_replace(label_replace(label_replace(sum by (recommendation) (resumai_funnel_recommendation_count_total), \"recommendation\", \"需人工复核\", \"recommendation\", \"NEED_MANUAL_REVIEW\"), \"recommendation\", \"推荐\", \"recommendation\", \"RECOMMEND\"), \"recommendation\", \"强烈推荐\", \"recommendation\", \"STRONG_RECOMMEND\"), \"recommendation\", \"拒绝\", \"recommendation\", \"REJECT\")",
          "legendFormat": "{{recommendation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无样本",
          "mappings": [
            {
              "type": "value",
              "options": {
                "NEED_MANUAL_REVIEW": {
                  "index": 0,
                  "text": "需人工复核"
                },
                "RECOMMEND": {
                  "index": 1,
                  "text": "推荐"
                },
                "STRONG_RECOMMEND": {
                  "index": 2,
                  "text": "强烈推荐"
                },
                "REJECT": {
                  "index": 3,
                  "text": "拒绝"
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "各 Agent 执行耗时 P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(histogram_quantile(0.95, sum by (agent, le) (rate(resumai_agent_span_duration_seconds_bucket{agent=~\"$agent\"}[$__rate_interval]))), \"agent\", \"任务编排器\", \"agent\", \"OrchestratorAgent\"), \"agent\", \"简历解析器\", \"agent\", \"ResumeParserAgent\"), \"agent\", \"技术评估\", \"agent\", \"TechAgent\"), \"agent\", \"项目评估\", \"agent\", \"ProjectAgent\"), \"agent\", \"风险识别\", \"agent\", \"RiskAgent\"), \"agent\", \"岗位匹配\", \"agent\", \"JdMatchAgent\"), \"agent\", \"质量校验\", \"agent\", \"RagasJudgeAgent\"), \"agent\", \"报告生成\", \"agent\", \"FinalReportAgent\"), \"agent\", \"大模型评估\", \"agent\", \"DeepSeekChatModel\"), \"agent\", \"混合检索\", \"agent\", \"HybridRagStrategy\"), \"agent\", \"需求分析\", \"agent\", \"JdAnalysisAgent\"), \"agent\", \"历史匹配\", \"agent\", \"HistoricalRagAgent\"), \"agent\", \"外部检索\", \"agent\", \"ExternalProfileAgent\"), \"agent\", \"并发引擎\", \"agent\", \"DAGEngine\")",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "暂无样本",
          "mappings": [
            {
              "type": "value",
              "options": {
                "OrchestratorAgent": {
                  "index": 0,
                  "text": "任务编排器"
                },
                "ResumeParserAgent": {
                  "index": 1,
                  "text": "简历解析器"
                },
                "TechAgent": {
                  "index": 2,
                  "text": "技术评估"
                },
                "ProjectAgent": {
                  "index": 3,
                  "text": "项目评估"
                },
                "RiskAgent": {
                  "index": 4,
                  "text": "风险识别"
                },
                "JdMatchAgent": {
                  "index": 5,
                  "text": "岗位匹配"
                },
                "RagasJudgeAgent": {
                  "index": 6,
                  "text": "质量校验"
                },
                "FinalReportAgent": {
                  "index": 7,
                  "text": "报告生成"
                },
                "DeepSeekChatModel": {
                  "index": 8,
                  "text": "大模型评估"
                },
                "HybridRagStrategy": {
                  "index": 9,
                  "text": "混合检索"
                },
                "JdAnalysisAgent": {
                  "index": 10,
                  "text": "需求分析"
                },
                "HistoricalRagAgent": {
                  "index": 11,
                  "text": "历史匹配"
                },
                "ExternalProfileAgent": {
                  "index": 12,
                  "text": "外部检索"
                },
                "DAGEngine": {
                  "index": 13,
                  "text": "并发引擎"
                }
              }
            }
          ]
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "resumai",
    "agents",
    "中文"
  ],
